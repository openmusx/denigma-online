# Put the map in nginx's http block.
map $uri $denigma_cache_control {
    ~^/assets/ "public, max-age=31536000, immutable";
    default     "no-cache";
}

# Merge these settings into the appropriate server block.
server {
    listen 443 ssl;
    server_name denigma.example.com;
    root /var/www/denigma;
    gzip_static on;

    location / {
        try_files $uri $uri/ =404;
    }

    # Keep this explicit even when the system mime.types already defines WASM.
    location ~* \.wasm$ {
        default_type application/wasm;
        try_files $uri =404;
    }

    add_header Cache-Control $denigma_cache_control always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'" always;

    # Add the site's normal ssl_certificate directives here.
}
