Options -MultiViews

AddType application/wasm .wasm

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve generated precompressed sidecars when the browser accepts gzip.
    RewriteCond %{HTTP:Accept-Encoding} (^|[,\s])gzip([,\s]|$) [NC]
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.+\.(wasm|js))$ $1.gz [L]
</IfModule>

<IfModule mod_headers.c>
    # Revalidate HTML and other unhashed files on every visit.
    Header always set Cache-Control "no-cache"

    # Content-hashed assets never change at a given URL.
    <FilesMatch "\.[0-9a-f]{12}\.(css|js|wasm)(\.gz)?$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(wasm|js)(\.gz)?$">
        Header always merge Vary "Accept-Encoding"
    </FilesMatch>

    <FilesMatch "\.wasm\.gz$">
        Header always set Content-Encoding "gzip"
        Header always set Content-Type "application/wasm"
    </FilesMatch>

    <FilesMatch "\.js\.gz$">
        Header always set Content-Encoding "gzip"
        Header always set Content-Type "text/javascript"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
</IfModule>
