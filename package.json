{
  "name": "denigma-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "setup:vscode": "node scripts/setup-vscode.mjs",
    "setup:vscode:force": "node scripts/setup-vscode.mjs --force",
    "configure": "node scripts/configure.mjs",
    "configure:local": "node scripts/configure.mjs --denigma ../denigma",
    "build": "cmake --build build-wasm --target web_dist --parallel 2",
    "serve": "node scripts/serve.mjs dist 8080",
    "test": "node --test tests/*.test.mjs",
    "test:wasm": "node tests/wasm-smoke.mjs build-wasm/wasm/denigma.js build-wasm/wasm/denigma.wasm tests/data/linked-parts.musx",
    "build:web": "node scripts/build-web.mjs build-wasm/wasm/denigma.js build-wasm/wasm/denigma.wasm"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
